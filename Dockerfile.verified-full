# =============================================================================
# BUILD FROM VERIFIED (not "fix our fork forever")
# Base = official RunPod worker-comfyui. Product layers only. Stock /start.sh.
#
# Verified fixes we honor (docs + golden-paths):
# - ready + IN_QUEUE/inProgress:0  => broken image; use stock dispatch path
# - network volume + runpod 1.7.11-1.10.0 => job tracking corruption; pin >=1.10.1
# - lifecycle = official /start.sh (GPU preflight + Comfy + handler together)
#
# See VERIFIED_BASE.md
# =============================================================================

ARG BASE_TAG=5.8.6-base
FROM runpod/worker-comfyui:${BASE_TAG}

USER root

# --- Comfy core: 5.8.6 base predates open-weight Krea2 TE (comfy.text_encoders.krea2) ---
# Keep this surgical: only what product needs; do not replace /start.sh or /handler.py.
RUN set -eux; \
  cd /tmp; \
  wget -qO comfy.tgz https://github.com/comfyanonymous/ComfyUI/archive/refs/heads/master.tar.gz; \
  tar xzf comfy.tgz; \
  SRC=/tmp/ComfyUI-master; \
  test -d "$SRC/comfy"; \
  cp -a /comfyui/extra_model_paths.yaml /tmp/emp.yaml 2>/dev/null || true; \
  rm -rf /comfyui/comfy; \
  cp -a "$SRC/comfy" /comfyui/comfy; \
  for f in nodes.py folder_paths.py execution.py server.py main.py latent_preview.py cuda_malloc.py node_helpers.py; do \
    if [ -f "$SRC/$f" ]; then cp -f "$SRC/$f" /comfyui/; fi; \
  done; \
  for d in comfy_extras api_server app utils middleware; do \
    if [ -d "$SRC/$d" ]; then rm -rf "/comfyui/$d"; cp -a "$SRC/$d" "/comfyui/$d"; fi; \
  done; \
  if [ -f "$SRC/requirements.txt" ]; then \
    (uv pip install -r "$SRC/requirements.txt" || pip install -r "$SRC/requirements.txt" || true); \
  fi; \
  if [ -f /tmp/emp.yaml ]; then cp -f /tmp/emp.yaml /comfyui/extra_model_paths.yaml; fi; \
  python -c "import comfy.text_encoders.krea2; print('krea2_ok')"; \
  rm -rf /tmp/comfy.tgz /tmp/ComfyUI-master

# Product custom nodes (on top of verified worker — do not reimplement handler)
COPY custom_nodes/universal_seamless/ /comfyui/custom_nodes/universal_seamless/
COPY custom_nodes/pp_krea2/ /comfyui/custom_nodes/pp_krea2/

# Official path map + diffusion_models + text_encoders (stock yaml lacks these keys)
COPY extra_model_paths.yaml /comfyui/extra_model_paths.yaml

# Optional: non-blocking hardlinks then exec stock start (does NOT replace Comfy/handler lifecycle)
COPY scripts/pp_flash_start.sh /pp_flash_start.sh
# Legacy prewarm kept in image for later B experiments only — NOT default CMD
COPY scripts/prewarm.sh /prewarm.sh
COPY scripts/prewarm_prompt.py /prewarm_prompt.py
COPY scripts/upstream_start.sh.5.8.6 /upstream_start.sh.5.8.6

RUN set -eux; \
  test -f /comfyui/custom_nodes/universal_seamless/__init__.py; \
  test -f /comfyui/custom_nodes/pp_krea2/__init__.py; \
  grep -q PPKrea2UNETLoader /comfyui/custom_nodes/pp_krea2/__init__.py; \
  grep -q MakeCircularVAEDiT /comfyui/custom_nodes/universal_seamless/__init__.py; \
  test -f /start.sh; \
  test -f /handler.py; \
  chmod +x /pp_flash_start.sh /prewarm.sh; \
  (uv pip install --system 'runpod>=1.10.1' || pip install -U 'runpod>=1.10.1'); \
  python -c "import importlib.metadata as m; v=m.version('runpod'); print('runpod', v); assert tuple(int(x) for x in v.split('.')[:3]) >= (1, 10, 1), v"

# DEFAULT = verified dispatch path (golden-path / docs).
# Override only after EmptyImage assign works:
#   docker run ... (same image) with command ["/pp_flash_start.sh"]  # hardlink + stock start
#   or ["/prewarm.sh"]  # product VRAM prewarm — B only, can desync ready vs pull if broken
CMD ["/start.sh"]
